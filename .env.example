# Copy to .env (local) or paste into Dokploy's Environment tab.

# HTTP
DBM_ADDR=:8080
# Public URL used to build the OIDC redirect and to decide Secure cookies.
DBM_BASE_URL=https://dbm.example.com
# Set to "true" ONLY when behind a reverse proxy that sets X-Forwarded-For /
# X-Real-IP; otherwise the client IP (used for auth rate-limiting) is the socket
# peer and forwarded headers are ignored so they can't be spoofed.
DBM_TRUST_PROXY=false

# Observability
# Log level (debug|info|warn|error) and format (json|text). JSON is the default
# so a log shipper can forward to a SIEM; text is friendlier for local dev.
DBM_LOG_LEVEL=info
DBM_LOG_FORMAT=json
# When set, /metrics requires this value as a Bearer token. Leave empty to serve
# /metrics openly (fine when the port is only reachable on a private network).
DBM_METRICS_TOKEN=
# Purge audit rows older than this many days (0 = keep forever).
DBM_AUDIT_RETENTION_DAYS=0

# Credential encryption (REQUIRED in production)
# 32 bytes as 64 hex chars. Saved connection passwords are AES-256-GCM encrypted
# with this key.
#   Generate with: openssl rand -hex 32
DBM_ENC_KEY=
# Key rotation (optional, supersedes DBM_ENC_KEY when set). Multiple keys as
# "id:key,id:key,..."; the FIRST is the primary used for new writes, the rest are
# retained only to decrypt data not yet re-encrypted. To rotate without downtime:
#   1. set DBM_ENC_KEYS="v2:<newkey>,v1:<oldkey>" (new primary first) and restart
#   2. trigger "Re-encrypt" in the UI (admin) or POST /api/admin/reencrypt
#   3. once re-encrypted, drop the old key: DBM_ENC_KEYS="v2:<newkey>"
# DBM_ENC_KEYS=v2:...,v1:...

# Metadata store
DBM_SQLITE_PATH=/data/verix-dbm.db

# DEV mode (auth DISABLED local dev only)
# When "true", every request is auto-logged-in as a local admin and Keycloak is
# not required. Must be set EXPLICITLY: a missing/incomplete OIDC config no
# longer silently disables auth (that would fail open). In production the app
# REFUSES TO START without OIDC unless this is set. NEVER enable it on an
# internet-reachable deployment.
DBM_DEV_MODE=false

# Keycloak OIDC (REQUIRED in production, i.e. whenever DBM_DEV_MODE != true)
# Create a Keycloak client; valid redirect URI: ${DBM_BASE_URL}/auth/callback
OIDC_ISSUER=https://keycloak.example.com/realms/yourrealm
OIDC_CLIENT_ID=verix-dbm
OIDC_CLIENT_SECRET=
# Defaults to ${DBM_BASE_URL}/auth/callback when empty.
OIDC_REDIRECT_URL=
# Realm roles → capabilities. Access is DENY-BY-DEFAULT: a user needs one of
# these roles or they get 403. Admin = everything (incl. DROP/FLUSH + connection
# CRUD); write = mutate data (implies read); read = browse/query only.
OIDC_ADMIN_ROLE=dbm-admin
OIDC_WRITE_ROLE=dbm-write
OIDC_READ_ROLE=dbm-read
# Set "true" to grant READ to ANY authenticated realm user regardless of role
# (the pre-hardening behaviour). Leave false unless this realm is dedicated to
# this app and every realm user may read every connected database.
DBM_OPEN_READ=false

# Set "true" to scope non-admin access per connection. With it on, a non-admin
# user reaches a connection only if an admin has granted one of their Keycloak
# groups / realm roles "read" or "write" on it (managed in the connection's edit
# dialog). A grant scopes WHERE a user acts, never above their global capability.
# Global admins always see and manage everything. Off (default) = global roles
# apply to every connection.
DBM_SCOPED_ACCESS=false
